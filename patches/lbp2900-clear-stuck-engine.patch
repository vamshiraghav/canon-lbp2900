@@ -204,45 +204,108 @@ static void send_job_start(uint8_t fg)
  * sequence (GoOffline → DiscardData → ClearMisPrint → ClearError → GoOnline)
  * and retry once.  Returns the job ID extracted from buf[2:3].
  */
+/*
+ * ReserveUnit's own reply byte is the busy/error flag. GetExtendedStatus can
+ * still say the printer is free (0x01) while ReserveUnit returns 0x8c, so the
+ * decision to clear has to use the ReserveUnit reply, not the status word.
+ * 0x8c is the engine holding a unit from a job whose USB session already died.
+ */
+static void capt_release_stuck_unit(uint16_t job_id)
+{
+	const struct capt_status_s *status = capt_get_xstatus_only();
+	uint8_t jbuf[2];
+
+	fprintf(stderr, "DEBUG: CAPT: engine status=0x%04x pap=0x%02x eng=0x%04x\n",
+		status->status[0], status->xstat_pap, status->xstat_eng);
+	if (status->xstat_pap == 0x00) {
+		fprintf(stderr, "STATE: +media-empty\n");
+		fprintf(stderr, "ERROR: CAPT: the printer reports no paper\n");
+	}
+
+	if (!FLAG(status, CAPT_FL_OFFLINE)) {
+		capt_sendrecv(CAPT_GO_OFFLINE, lbp3000_job_init,
+			ARRAY_SIZE(lbp3000_job_init), NULL, 0);
+		for (int i = 0; i < 20; i++) {
+			status = capt_get_xstatus_only();
+			if (FLAG(status, CAPT_FL_OFFLINE))
+				break;
+			usleep(100000);
+		}
+	}
+
+	jbuf[0] = LO(job_id);
+	jbuf[1] = HI(job_id);
+	fprintf(stderr, "DEBUG: CAPT: ReleaseUnit job %u\n", job_id);
+	capt_sendrecv(CAPT_RELEASE_UNIT, jbuf, 2, NULL, 0);
+	if (job_id != 0) {
+		jbuf[0] = 0;
+		jbuf[1] = 0;
+		capt_sendrecv(CAPT_RELEASE_UNIT, jbuf, 2, NULL, 0);
+	}
+	capt_sendrecv(CAPT_DISCARD_DATA, NULL, 0, NULL, 0);
+	capt_sendrecv(CAPT_CLEAR_MIS_PRINT, NULL, 0, NULL, 0);
+	capt_sendrecv(CAPT_CLEAR_ERROR, NULL, 0, NULL, 0);
+	capt_sendrecv(CAPT_GO_ONLINE, magicbuf_linux_online,
+		ARRAY_SIZE(magicbuf_linux_online), NULL, 0);
+	usleep(300000);
+}
